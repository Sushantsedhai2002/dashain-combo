{
  "name": "dashain-offer-radar",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0",
    "pnpm": "10.26.1"
  },
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "typecheck": "tsc --noEmit --project tsconfig.base.json && pnpm --recursive --if-present run typecheck",
    "lint": "eslint .",
    "format:check": "prettier --check \"**/*.{json,js,mjs,cjs,ts,tsx,yaml,yml}\"",
    "catalog:db:up": "docker compose -f config/postgres.compose.yml up -d --wait",
    "catalog:db:down": "docker compose -f config/postgres.compose.yml down --volumes",
    "catalog:migrate": "pnpm --filter @dashain-offer/offer-catalog migrate",
    "catalog:test:integration": "pnpm --filter @dashain-offer/offer-catalog test:integration",
    "catalog:test:integration:coverage": "pnpm --filter @dashain-offer/offer-catalog test:integration:coverage",
    "ingestion:once": "pnpm --filter @dashain-offer/offer-ingestion ingest",
    "ingestion:worker": "pnpm --filter @dashain-offer/offer-ingestion worker",
    "ingestion:evaluate": "pnpm --filter @dashain-offer/offer-ingestion evaluate",
    "web:dev": "pnpm --filter @dashain-offer/discovery-web start",
    "web:start": "pnpm --filter @dashain-offer/discovery-web start",
    "ingestion:test:integration": "pnpm --filter @dashain-offer/offer-ingestion test:integration",
    "ingestion:test:integration:coverage": "pnpm --filter @dashain-offer/offer-ingestion test:integration:coverage",
    "sources:check": "pnpm --filter @dashain-offer/source-registry sources:check",
    "sources:validate": "pnpm --filter @dashain-offer/source-registry sources:validate",
    "test": "vitest run --config vitest.workspace.ts --passWithNoTests",
    "test:coverage": "vitest run --config vitest.workspace.ts --coverage --passWithNoTests",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:coverage && pnpm build && pnpm sources:validate"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "8.71.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.0.2"
  }
}
