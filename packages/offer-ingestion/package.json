{
  "name": "@dashain-offer/offer-ingestion",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit --project tsconfig.json",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "lint": "eslint src test",
    "ingest": "node src/cli/ingest-entry.mjs",
    "worker": "node src/cli/worker-entry.mjs",
    "test": "vitest run --root ../.. --config vitest.workspace.ts packages/offer-ingestion/test",
    "test:coverage": "vitest run --root ../.. --config vitest.workspace.ts --coverage packages/offer-ingestion/test",
    "test:integration": "vitest run --root ../.. --config packages/offer-ingestion/vitest.integration.config.ts",
    "test:integration:coverage": "vitest run --root ../.. --config packages/offer-ingestion/vitest.integration.config.ts --coverage"
  },
  "dependencies": {
    "@dashain-offer/offer-catalog": "workspace:*",
    "@dashain-offer/source-registry": "workspace:*",
    "cheerio": "1.2.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
